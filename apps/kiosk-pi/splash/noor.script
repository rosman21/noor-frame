# Noor Frame's boot splash for a Raspberry Pi wall screen (sudo install.sh frame --splash).
# The finished frame of Noor's boot animation, filling the screen, fading in from the green.

Window.SetBackgroundTopColor(0.02, 0.16, 0.12);
Window.SetBackgroundBottomColor(0.02, 0.16, 0.12);

image = Image("noor.png");
scale = Math.Max(Window.GetWidth() / image.GetWidth(), Window.GetHeight() / image.GetHeight());
picture = image.Scale(image.GetWidth() * scale, image.GetHeight() * scale);
sprite = Sprite(picture);
sprite.SetX(Window.GetX() + (Window.GetWidth() - picture.GetWidth()) / 2);
sprite.SetY(Window.GetY() + (Window.GetHeight() - picture.GetHeight()) / 2);
sprite.SetOpacity(0);

shown = 0;
fun refresh() {
  if (shown < 1) {
    shown = Math.Min(1, shown + 0.04);
    sprite.SetOpacity(shown);
  }
}
Plymouth.SetRefreshFunction(refresh);
