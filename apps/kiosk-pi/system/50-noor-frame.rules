// /etc/polkit-1/rules.d/50-noor-frame.rules
// Lets the noor user manage Wi-Fi (the kiosk helper's setup network), without root.
polkit.addRule(function (action, subject) {
  if (action.id.indexOf("org.freedesktop.NetworkManager.") === 0 && subject.user === "noor") {
    return polkit.Result.YES;
  }
});
