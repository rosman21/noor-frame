# The screen: Chromium full screen in cage (a kiosk Wayland compositor) on the first console.
[Unit]
Description=noor-frame screen
After=systemd-user-sessions.service plymouth-quit-wait.service noor-kiosk-helper.service
Wants=noor-kiosk-helper.service
Conflicts=getty@tty1.service

[Service]
User=noor
PAMName=noor-kiosk
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
EnvironmentFile=-/etc/noor-frame/kiosk.env
ExecStart=/usr/bin/cage -s -- /usr/local/lib/noor-frame/noor-browser
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
